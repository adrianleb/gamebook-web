{
  "name": "gamebook-web",
  "version": "0.1.0",
  "description": "Browser-based RPG/adventure game with DOS-style presentation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "validate:content": "node src/tools/validate-content.js",
    "validate:assets": "node src/tools/validate-assets.cjs",
    "analyze:balance": "npx tsx src/tools/analyze-balance.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
